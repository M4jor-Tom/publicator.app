#!/usr/bin/env bash
# Cheap whole-flake check before each commit; post-commit gates the commit with the slow checks.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Git exports index paths to hooks; Nix and package tests must see the plain checkout.
# shellcheck disable=SC2046 # one variable name per line
unset $(git rev-parse --local-env-vars)
exec nix flake check -L
