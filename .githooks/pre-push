#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# A working-tree check must not approve different commits or uncommitted fixes.
check=false
head=$(git rev-parse HEAD)
while read -r _local_ref local_oid _remote_ref _remote_oid; do
    [[ "$local_oid" =~ ^0+$ ]] && continue
    if [[ "$local_oid" != "$head" ]]; then
        echo "Quality checks require pushing the checked-out commit; check out the branch being pushed." >&2
        exit 1
    fi
    check=true
done
"$check" || exit 0
if [[ -n "$(git status --porcelain)" ]]; then
    echo "Quality checks require a clean working tree; commit or stash changes before pushing." >&2
    exit 1
fi
# Every check runs even after a failure; the push fails with the first failing status.
status=0
for check in "run .#quality" "run .#native-acceptance" "flake check -L"; do
    # shellcheck disable=SC2086 # each entry is a fixed nix argument list
    nix $check || { code=$?; echo "pre-push: nix $check failed ($code)" >&2; ((status)) || status=$code; }
done
exit "$status"
