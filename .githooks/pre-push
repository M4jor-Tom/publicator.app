#!/usr/bin/env bash
# Pushes only commits whose background gate (post-commit → quality-gate) passed. CI reruns every check.
set -euo pipefail
dir=$(git rev-parse --path-format=absolute --git-common-dir)/quality-gate
status=0
while read -r _local_ref local_oid remote_ref _remote_oid; do
    [[ "$local_oid" =~ ^0+$ ]] && continue
    # Software-factory branches are gated by factory/checks.sh before review and before merge.
    [[ "$remote_ref" == refs/heads/factory/* ]] && continue
    if ! sha=$(git rev-parse --verify --quiet "$local_oid^{commit}"); then
        echo "pre-push: $local_oid is not a commit; nothing can gate it." >&2
        status=1
        continue
    fi
    result=$(cat "$dir/$sha" 2>/dev/null) || result=missing
    case "$result" in
        ok) continue ;;
        missing) echo "pre-push: ${sha:0:12} was never gated; run .githooks/post-commit $sha" >&2 ;;
        running) echo "pre-push: the gate for ${sha:0:12} is still running; log: $dir/$sha.log" >&2 ;;
        *) echo "pre-push: the gate for ${sha:0:12} ended '$result'; log: $dir/$sha.log" >&2 ;;
    esac
    status=1
done
exit "$status"
